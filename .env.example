# Copy to .env (git-ignored) and fill in. Never commit the real file.
# Chat and embeddings are configured separately; each may point at a different gateway or key.

# --- chat model (classifiers, agentic arm) ---------------------------------
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
# Written into every run manifest: prefer a dated snapshot id over a moving alias when one exists.
LLM_MODEL=

# --- embeddings (canonicalisation, dense retrieval) ------------------------
EMB_API_KEY=
EMB_BASE_URL=https://api.openai.com/v1
EMB_MODEL=text-embedding-3-small

# --- behaviour (optional) --------------------------------------------------
# Some models reject a non-default temperature; the client then retries without it and records that.
GW_LLM_TEMPERATURE=0
# 1 = cache every request/response in artifacts/cache/llm.sqlite (re-runs are offline); 0 = bypass
GW_LLM_CACHE=1
# openai | fastembed. Default: openai when an embedding key is set, otherwise the local fastembed model.
GW_EMBED_BACKEND=
