# Copy to .env (git-ignored) and fill in. Never commit the real file.

# --- provider -------------------------------------------------------------
OPENAI_API_KEY=
# Optional: an OpenAI-compatible gateway. Leave empty for api.openai.com.
OPENAI_BASE_URL=

# --- models ---------------------------------------------------------------
# Chat model used by classifiers / the agentic arm. Required before any chat call; the id is written
# into every run manifest, so pin a dated snapshot rather than a moving alias when one exists.
GW_CHAT_MODEL=
GW_EMBED_MODEL=text-embedding-3-small

# --- behaviour ------------------------------------------------------------
GW_LLM_TEMPERATURE=0
# 1 = cache every request/response in artifacts/cache/llm.sqlite (re-runs are offline); 0 = bypass
GW_LLM_CACHE=1
# openai | fastembed. Default: openai when OPENAI_API_KEY is set, otherwise the local fastembed model.
GW_EMBED_BACKEND=
